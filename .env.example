# 請將此檔案複製為 .env 並填入實際值
SECRET_KEY=your-secret-key-here
DEBUG=True
CSRF_TRUSTED_ORIGINS=https://www.alittlewonder.com
USE_SQLITE=False

# 資料庫連線設定 (PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=alw_challenges
DB_USER=challenges_user
DB_PASSWORD=challenges_pass_secure_2026
DB_HOST=host.docker.internal
DB_PORT=5432

# Google OAuth 2.0 憑證 (由 Google Cloud Console 取得)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/

